# Copy to .env and fill in. Without LLM settings the assistant runs in extractive mode (no LLM).

# Option A: OpenAI
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Option B: free local model with Ollama (https://ollama.com): `ollama pull llama3.1:8b`
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# Option C: Azure OpenAI (OpenAI-compatible v1 endpoint)
# LLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1/
# LLM_API_KEY=<azure-key>
# LLM_MODEL=<deployment-name>

LLM_TEMPERATURE=0
LEAFLET_RAW_DIR=data/raw
LEAFLET_INDEX_DIR=data/index
LEAFLET_RETRIEVER=tfidf          # or "embeddings" (pip install -e ".[embeddings]")
LEAFLET_TOP_K=4
LEAFLET_MIN_SCORE=0.12           # below this retrieval score the assistant says "not found"
